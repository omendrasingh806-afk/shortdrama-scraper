# HTTP port assigned by Render automatically. Keep 3000 for local development.
PORT=3000

# Only microtv.st and www.microtv.st are accepted as source hosts.
SOURCE_URL=https://microtv.st/

# How long a successful homepage scrape stays in memory.
CACHE_TTL_SECONDS=900
# If a later scrape fails, serve the last successful data for this long.
STALE_CACHE_SECONDS=86400
REQUEST_TIMEOUT_MS=20000
MAX_HTML_BYTES=5242880

# Obey a disallow rule in the source site's robots.txt.
RESPECT_ROBOTS=true

# Comma-separated browser origins, or * for a public read-only API.
CORS_ORIGIN=*

# Optional: protects POST /api/dramas/refresh with x-refresh-token.
# REFRESH_TOKEN=replace-with-a-long-random-secret
